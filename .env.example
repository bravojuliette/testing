# Copia este archivo a ".env" (NUNCA lo subas a git) y rellena tus valores.
# En GitHub Actions, estos mismos nombres se configuran como Secrets del repo
# (Settings -> Secrets and variables -> Actions), no como archivo .env.

# Token de BetsAPI (https://betsapi.com/). NO lo compartas ni lo commitees.
BETSAPI_TOKEN=

# Resend (https://resend.com) para las alertas por email -- solo hace falta
# una API key, sin contrasenas de aplicacion. "onboarding@resend.dev" es el
# remitente de pruebas de Resend (funciona sin verificar dominio propio).
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
EMAIL_TO=tu_correo@gmail.com

# Ruta de la base de datos SQLite local (por defecto data/tt_elite.db).
# Se ignora si defines TURSO_DATABASE_URL abajo.
TT_ELITE_DB=data/tt_elite.db

# Opcional: base de datos remota Turso (SQLite alojado). Si la defines, TODO
# el sistema (collect/sweep/scan) usa Turso en vez del archivo local -- esto
# es lo que permite compartir los mismos datos entre GitHub Actions y el
# dashboard en Vercel. Ver README para como crear la base de datos.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
