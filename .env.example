# Copia este archivo a ".env" (NUNCA lo subas a git) y rellena tus valores.
# En GitHub Actions, estos mismos nombres se configuran como Secrets del repo
# (Settings -> Secrets and variables -> Actions), no como archivo .env.

# Token de BetsAPI (https://betsapi.com/). NO lo compartas ni lo commitees.
BETSAPI_TOKEN=

# SMTP para las alertas por email. Con Gmail: activa verificacion en 2 pasos y
# genera una "contrasena de aplicacion" en https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=
EMAIL_FROM=tu_correo@gmail.com
EMAIL_TO=tu_correo@gmail.com

# Ruta de la base de datos SQLite (por defecto data/tt_elite.db)
TT_ELITE_DB=data/tt_elite.db
