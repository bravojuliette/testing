# Copia a .env.local para desarrollo local (nunca subir el real a git).
# En Vercel: Project Settings -> Environment Variables, mismos nombres.

# Misma base de datos Turso que usa GitHub Actions.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Personal Access Token de GitHub con permiso "Actions: write" sobre el repo
# (fine-grained PAT, o classic con scope "repo"). Se usa SOLO en el servidor
# para disparar los workflows -- nunca se expone al navegador.
GITHUB_TOKEN=
GITHUB_OWNER=bravojuliette
GITHUB_REPO=testing
GITHUB_REF=claude/table-tennis-picks-system-c0twbv

# Contraseña compartida para entrar al dashboard (protege sobre todo los
# botones que lanzan scans/sweeps -- que cualquiera con el link no pueda).
APP_PASSWORD=
